/** @import { types } from 'vortex-api' */
import * as path from 'path';
import { selectors, util } from 'vortex-api';
import { GAME } from '../common/constants.js';

/**
 * Locates the {{gameName}} installation directory.
 *
 * Uses Vortex's `GameStoreHelper` to find the game by its Steam app ID.
 *
 * @returns {Promise<string>} A promise that resolves to the game installation path.
 */
export async function findGame() {
    const game = await util.GameStoreHelper.findByAppId(GAME.steamAppId, 'steam');
    return game.gamePath;
}

/**
 * Reads the current {{gameName}} discovery result from the Vortex state.
 *
 * @param {types.IExtensionApi} api - Vortex extension API.
 * @returns {types.IDiscoveryResult | undefined} The discovery result, or undefined if the game hasn't been discovered.
 */
export function getDiscovery(api) {
    return selectors.discoveryByGame(api.getState(), GAME.id);
}

/**
 * Resolves a path relative to the discovered game folder.
 *
 * @param {types.IDiscoveryResult} discovery - The game discovery result from Vortex.
 * @param {string} relativePath - Path relative to the game folder.
 * @returns {string} The absolute path.
 */
export function resolveGamePath(discovery, relativePath) {
    return path.join(discovery.path, relativePath);
}
