import { fs } from 'vortex-api';

/**
 * Checks asynchronously whether a file exists.
 *
 * @param {string} filePath - Absolute path of the file to check.
 * @returns {Promise<boolean>} A promise resolving to true if the file exists, false otherwise.
 */
export async function fileExistsAsync(filePath) {
    try {
        await fs.statAsync(filePath);
        return true;
    } catch {
        return false;
    }
}

/**
 * Checks synchronously whether a file exists.
 *
 * @param {string} filePath - Absolute path of the file to check.
 * @returns {boolean} True if the file exists, false otherwise.
 */
export function fileExistsSync(filePath) {
    try {
        fs.statSync(filePath);
        return true;
    } catch {
        return false;
    }
}

/**
 * Reads when a file was last modified.
 *
 * @param {string} filePath - Absolute path of the file.
 * @returns {Promise<number | undefined>} A promise resolving to the modification time in milliseconds, or undefined if the file doesn't exist.
 */
export async function modifiedTimeAsync(filePath) {
    try {
        const stats = await fs.statAsync(filePath);
        return stats.mtimeMs;
    } catch {
        return undefined;
    }
}
