/** @import { types } from 'vortex-api' */

/**
 * Creates an instruction that copies a file from the archive into the mod.
 *
 * @param {string} source - Path inside the extracted archive.
 * @param {string} destination - Path relative to the mods folder.
 * @returns {types.IInstruction} The copy instruction.
 */
export function copyInstruction(source, destination) {
    return { type: 'copy', source, destination };
}

/**
 * Creates an instruction that cancels the installation and shows the user why.
 *
 * @param {string} message - The reason shown to the user.
 * @returns {types.IInstruction} The error instruction.
 */
export function fatalErrorInstruction(message) {
    return { type: 'error', value: 'fatal', source: message };
}
