{
    "compilerOptions": {
        "module": "esnext",
        "moduleResolution": "bundler",
        "target": "ES2022",
        "checkJs": true,
        "strict": false,
        "esModuleInterop": true,
        "noEmit": true,
        "maxNodeModuleJsDepth": 0,
        "skipLibCheck": true,
        "types": [
            "node"
        ]
    },
    "include": [
        "src/**/*.js"
    ]
}
