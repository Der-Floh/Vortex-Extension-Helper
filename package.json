{
    "name": "vortex-extension-helper",
    "displayName": "Vortex Extension Helper",
    "description": "Helps create and validate Vortex game support extensions",
    "version": "0.2.0",
    "publisher": "der-floh",
    "license": "MIT",
    "icon": "assets/vortex-icon-x512.png",
    "repository": {
        "type": "git",
        "url": "https://github.com/Der-Floh/Vortex-Extension-Helper"
    },
    "bugs": {
        "url": "https://github.com/Der-Floh/Vortex-Extension-Helper/issues"
    },
    "homepage": "https://github.com/Der-Floh/Vortex-Extension-Helper",
    "markdown": "github",
    "qna": "https://github.com/Der-Floh/Vortex-Extension-Helper/issues",
    "keywords": [
        "vortex",
        "vortex-api",
        "nexusmods",
        "nexus-mods",
        "modding",
        "game-mods",
        "mod-manager",
        "game-extension",
        "vortex-extension",
        "typescript",
        "intellisense",
        "scaffolding"
    ],
    "engines": {
        "vscode": "^1.105.0"
    },
    "categories": [
        "Snippets",
        "Linters",
        "Other"
    ],
    "extensionKind": [
        "workspace"
    ],
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": "limited",
            "description": "In Restricted Mode the extension only detects and checks Vortex game extensions. Installing dependencies and libraries runs npm, which needs a trusted workspace."
        },
        "virtualWorkspaces": {
            "supported": false,
            "description": "Vortex game extensions are built with npm, which needs a real file system."
        }
    },
    "activationEvents": [
        "workspaceContains:package.json"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "vortexHelper.newGameSupportExtension",
                "title": "New Game Support Extension",
                "category": "Vortex"
            },
            {
                "command": "vortexHelper.setupVortexApi",
                "title": "Install Dependencies",
                "category": "Vortex"
            },
            {
                "command": "vortexHelper.scaffoldGameExtension",
                "title": "Create Missing Files",
                "category": "Vortex"
            },
            {
                "command": "vortexHelper.runWorkspaceChecks",
                "title": "Run Workspace Checks",
                "category": "Vortex"
            },
            {
                "command": "vortexHelper.openDocumentation",
                "title": "Open Extension Documentation",
                "category": "Vortex"
            },
            {
                "command": "vortexHelper.addVortexLibrary",
                "title": "Add Vortex Library",
                "category": "Vortex"
            }
        ],
        "menus": {
            "commandPalette": [
                {
                    "command": "vortexHelper.setupVortexApi",
                    "when": "vortexHelper.isVortexWorkspace && isWorkspaceTrusted"
                },
                {
                    "command": "vortexHelper.scaffoldGameExtension",
                    "when": "vortexHelper.isVortexWorkspace"
                },
                {
                    "command": "vortexHelper.runWorkspaceChecks",
                    "when": "workspaceFolderCount > 0"
                },
                {
                    "command": "vortexHelper.addVortexLibrary",
                    "when": "vortexHelper.isVortexWorkspace && isWorkspaceTrusted"
                }
            ]
        },
        "configuration": {
            "title": "Vortex Extension Helper",
            "properties": {
                "vortexHelper.useNexusApi": {
                    "type": "boolean",
                    "default": true,
                    "order": 0,
                    "markdownDescription": "Pick the game from the public Nexus Mods game list when creating a game support extension. When off, or when the list can't be loaded, **Vortex: New Game Support Extension** asks for the game's name and Nexus Mods domain."
                },
                "vortexHelper.author": {
                    "type": "string",
                    "default": "",
                    "order": 1,
                    "markdownDescription": "Author written to `package.json` of new game support extensions. When empty, **Vortex: New Game Support Extension** asks for it."
                },
                "vortexHelper.askSteamAppId": {
                    "type": "boolean",
                    "default": true,
                    "order": 2,
                    "markdownDescription": "Ask for the game's Steam app id when creating a game support extension. When off, `src/common/constants` gets the placeholder `STEAM_APP_ID`, which **Vortex: Run Workspace Checks** reports."
                },
                "vortexHelper.askExecutable": {
                    "type": "boolean",
                    "default": true,
                    "order": 3,
                    "markdownDescription": "Ask for the game's executable, relative to the game folder, when creating a game support extension. When off, the placeholder `GAME_EXECUTABLE.exe` is used."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "npm run check-types && npm run lint && node esbuild.mjs",
        "watch": "node ./node_modules/npm-run-all/bin/npm-run-all/index.js -p watch:*",
        "watch:esbuild": "node esbuild.mjs --watch",
        "watch:tsc": "node ./node_modules/typescript/bin/tsc --noEmit --watch --project tsconfig.json",
        "package": "node ./node_modules/@vscode/vsce/vsce package --no-dependencies",
        "compile-tests": "node esbuild.mjs --tests",
        "pretest": "npm run check-types && npm run compile-tests",
        "check-types": "node ./node_modules/typescript/bin/tsc --noEmit",
        "lint": "node ./node_modules/eslint/bin/eslint.js src",
        "test": "node ./out/test/runTests.js"
    },
    "devDependencies": {
        "@types/bluebird": "3.5.20",
        "@types/mocha": "^10.0.10",
        "@types/node": "26.x",
        "@types/vscode": "~1.105.0",
        "@typescript-eslint/eslint-plugin": "^8.71.2",
        "@typescript-eslint/parser": "^8.71.1",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "^4.0.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.13.0",
        "mocha": "^12.0.3",
        "npm-run-all": "^4.1.5",
        "typescript": "~7.0.2",
        "vortex-api": "github:Nexus-Mods/vortex-api"
    },
    "dependencies": {
        "jsonc-parser": "^3.3.1"
    }
}
